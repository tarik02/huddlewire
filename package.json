{
  "name": "huddlewire",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop control plane for Slack Huddles",
  "license": "MIT",
  "bin": {
    "huddlewire": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
